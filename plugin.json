{
    "$schema": "https://github.com/duxlabs-dev/dux-shell/raw/refs/heads/master/quickshell/PLUGINS/plugin-schema.json",
    "id": "mediaPlayer",
    "name": "Media Player",
    "description": "Desktop MPRIS player with spinning album art, playback controls, a seekbar and an optional wave background.",
    "version": "2.0.0",
    "author": "bernardopg",
    "license": "MIT",
    "icon": "music_note",
    "type": "desktop",
    "capabilities": ["desktop-widget", "media-player", "mpris"],
    "component": "./MediaPlayerWidget.qml",
    "settings": "./MediaPlayerSettings.qml",
    "requires_dms": ">=2.0.0",
    "permissions": ["settings_read", "settings_write"]
}
